GROQ_API_KEY=gsk_...
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
NEXT_PUBLIC_BASE_URL=https://your-domain.vercel.app

# Server-only. Bypasses RLS; never expose to the browser.
# Required by supabase/migrations/002_whispers_lock_down.sql, and by accounts:
# /api/save and /api/stars verify the caller's token with this key.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Accounts ────────────────────────────────────────────────────────────────
# No extra variables. Sign-in uses the two NEXT_PUBLIC_SUPABASE_* values
# above, and with neither set the app hides the sign-in entry point entirely
# rather than offering a door that opens onto an apology.
#
# There is ONE piece of setup that is not in this repository. Supabase's
# default email for this flow carries only the link, not the six-digit code,
# so the template needs editing once:
#
#   Authentication -> Emails -> Magic Link -> include {{ .Token }}
#
# Until then the email arrives with a working link and no digits. See
# docs/accounts.md.

# ── Aether's voice (optional) ───────────────────────────────────────────────
# All server-only. Unset, /api/speak answers 503 and the app uses the
# browser's own speech — which is what production does today. See
# docs/voice-engine.md for which provider to choose and what it costs.

# Route A — a hosted API. Either one; set VOICE_PROVIDER only if both are.
# ELEVENLABS_API_KEY=sk_...
# ELEVENLABS_VOICE_ID=...            # the cloned voice
# ELEVENLABS_MODEL=eleven_flash_v2_5
# CARTESIA_API_KEY=sk_car_...
# CARTESIA_VOICE_ID=...
# VOICE_PROVIDER=elevenlabs

# Route B — an open model on a GPU we rent. One POST {text} -> audio bytes.
# VOICE_ENDPOINT_URL=https://your-gpu-host/tts
# VOICE_ENDPOINT_TOKEN=...
